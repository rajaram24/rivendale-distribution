{%- comment -%} /templates/customers/login.liquid {%- endcomment -%}
<section class="page-customer" data-account-form>
  <div class="custom-for-back">
  <div class="wrapper custom-main-form">
    <div class="bussiness-account">
      <div class="main-bussiness-acc">
        <div class="bussiness-title"><h3>Create a Bussiness Account</h3></div>
        <div class="wholesale"><a href="https://www.rivendelldistribution.com/pages/register" class="btn">Create a Business Account</a></div>
      </div>
    </div>
    <div class="login-form-wrraper">
    <div class="form-vertical-wrapper">
      <p class="text-left is-hidden" data-recover-success-text>{{ 'customer.recover_password.success' | t }}</p>

      <div id="CustomerLoginForm" class="form-vertical is-hidden" data-login-form>
        {% form 'customer_login', id: 'CustomerLogin' %}
          <div class="note form-success" id="ResetSuccess" {% unless form.posted_successfully? %}style="display:none;"{% endunless %}>
            {{ 'customer.recover_password.success' | t }}
          </div>
          <div class="section__header">
            <h2 class="section__heading account__heading--small">{{ 'customer.login.title' | t }}</h2>
            {%- if settings.show_spacer_lines -%}
              <hr class="section__heading-line">
            {%- endif -%}
           
          </div>
          {{ form.errors | default_errors }}
          <label for="CustomerEmail" class="hidden-label">{{ 'customer.login.email' | t }}</label>
          <input type="email" name="customer[email]" id="CustomerEmail" class="input--full{% if form.errors contains 'email' %} error{% endif %}" placeholder="{{ 'customer.login.email' | t }}" autocorrect="off" autocapitalize="off" autofocus required>
          {% if form.password_needed %}
            <label for="CustomerPassword" class="hidden-label">{{ 'customer.login.password' | t }}</label>
            <input type="password" value="" name="customer[password]" id="CustomerPassword" class="input--full{% if form.errors contains 'password' %} error{% endif %}" placeholder="{{ 'customer.login.password' | t }}" required>
          {% endif %}
          
          <button type="submit" class="btn">{{ 'customer.login.sign_in' | t }}</button>
          <div class = "return light-gray">
            {% if form.password_needed %}
              <p><a href="#RecoverPasswordForm" id="RecoverPassword" data-show-reset>{{ 'customer.login.forgot_password' | t }}</a></p>
            {% endif %}
          </div>
        {% endform %}
      </div>
    </div>
      <div id="RecoverPasswordForm" class="text-left is-hidden" data-recover-password>
        <h2 class="account__heading account__heading--small">{{ 'customer.recover_password.title' | t }}</h2>
        <div class="form-vertical">
          {% form 'recover_customer_password', id: 'RecoverCustomerPassword' %}
            {{ form.errors | default_errors }}

            {% if form.posted_successfully? %}
              <div data-recover-success></div>
            {% else %}
              <p class="light-gray" style="color:#fff">{{ 'customer.recover_password.subtext' | t }}</p>
            {% endif %}

            <label for="RecoverEmail" class="hidden-label">{{ 'customer.recover_password.email' | t }}</label>
            <input type="email" value="" name="email" id="RecoverEmail" class="input--full" placeholder="{{ 'customer.recover_password.email' | t }}" autocorrect="off" autocapitalize="off" required>
            <button type="submit" class="btn">{{ 'customer.recover_password.submit' | t }}</button>
            <a href = "#CustomerLoginForm" type="button" id="HideRecoverPasswordLink" class="return light-gray" style="color:#fff" data-hide-reset>{{ 'customer.recover_password.cancel' | t }}</a>
          {% endform %}
        </div>
      </div>
      {% comment %}
      If accounts are set as optional, the following will be shown as an option
      during checkout, not on the default /login page.
      {% endcomment %}


        <div class="forgot-wrraper">
        <div class="forget-title">
          <h3>Create Account</h3>
        </div>
      {% form 'create_customer', return_to: routes.account_url  %}
          {{ form.errors | default_errors }}
        
          <div class="first-name">
        <!--     <label for="first-name">First name</label> -->
            <input type="text" name="customer[first_name]"  placeholder="First name" class="input--full{% if form.errors contains 'first_name' %} error{% endif %}" required>
          </div>
        
          <div class="last-name">
        <!--     <label for="last-name">Last name</label> -->
            <input type="text" name="customer[last_name]" placeholder="Last name">
          </div>
        
          <div class="email">
        <!--     <label for="email">Email</label> -->
            <input type="email" name="customer[email]" placeholder="Email" required  class="input--full{% if form.errors contains 'email' %} error{% endif %}">
          </div>
        
          <div class="password">
        <!--     <label for="password">Password</label> -->
            <input type="password" name="customer[password]" placeholder="Password" required class="input--full{% if form.errors contains 'password' %} error{% endif %}">
          </div>
        <div class="phone_number">
        <input type="phone_number"  name="customer[phone_number]" id="phone_number" class="large" size="30" placeholder="Phone Number" />
        </div>
          <div class="submit">
            	 <button type="submit" class="btn">{{ 'customer.register.submit' | t }}</button>
          
          </div>
        {% endform %}
         
        </div>
      {% if shop.checkout.guest_login %}
        {%- if settings.show_spacer_lines -%}
          <hr class="section__heading-line">
        {%- endif -%}
        <h2>{{ 'customer.login.guest_title' | t }}</h2>
        {% form 'guest_login', id: 'GuestLogin' %}
          <button type="submit" class="btn">{{ 'customer.login.guest_continue' | t }}</button>
        {% endform %}
      {% endif %}
      
    </div>
  </div>
   
  </div>
  <div class="wrapper four-grids-with-icons">
    <div class="main-four-grids-heading">
      <h1>Automatic Member Benefits</h1>
    </div>
    <div class="main-four-grid-dividation">
      <div class="grid-icons">
        <img src="https://cdn.shopify.com/s/files/1/0530/9615/3277/files/download.webp?v=1672313905">
        <h3>TIERED PRICING AND BULK DISCOUNTS</h3>
        <p>Rivendell Distribution offers exclusive Pricing Tiers, Volume Discounts and local delivery for all Pre-qualified Dealers, Wholesalers and Contractors. Sign up now to receive these offers and more!</p>
      </div>
      <div class="grid-icons">
        <img src="https://cdn.shopify.com/s/files/1/0530/9615/3277/files/download_1.webp?v=1672313904">
        <h3>CUSTOM ORDERS AND
NON-STOCK INVENTORY</h3>
        <p>We have a dedicated sales staff to help put together your custom bids. Rivendell currently stocks a premier selection of products from our vendors. Though we do not stock all o ftheir products, if there is a specific product needed we can still source it without delay and at the best cost guaranteed.</p>
      </div>
      <div class="grid-icons">
        <img src="https://cdn.shopify.com/s/files/1/0530/9615/3277/files/download_2.webp?v=1672313904">
        <h3>LOCAL SHIPPING</br>
OPTIONS</h3>
        <p>Rivendell Distribution currently has one delivery truck that runs larger loads on Tuesday, Thursday, and Friday from March till November. Those orders are shipped on our own Semi with a Donkey forklift to help unload onsite. Other smaller orders can be shipped via: In-Store Pick-up, USPS, FedEx & UPS.</p>
      </div>
      <div class="grid-icons">
        <img src="https://cdn.shopify.com/s/files/1/0530/9615/3277/files/download_3.webp?v=1672313904">
        <h3>FULL TRUCKLOAD</br>
DELIVERIES</h3>
        <p>Rivendell Distribution offers full truckload discounts on local deliveries and direct shipments from manufacture to your location. From restocking your yard to tackling bigger projects, order large and save big!</p>
      </div>
    </div>
  </div>
</section>
<script>

  jQuery( document ).ready(function() {
jQuery('#SiteHeader').addClass('site-header--transparent');
  });
</script>