{% schema %}
{
  "name": "Trusted Partner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Trusted Partner for Landscaping Supplies"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Our team has decades of experience in the landscaping industry..."
    },
    {
      "type": "image_picker",
      "id": "right_image",
      "label": "Right Side Image"
    },
    {
      "type": "image_picker",
      "id": "mobile_image",
      "label": "Mobile Image"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Feature description goes here."
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Trusted Partner",
      "category": "Custom"
    }
  ]
}
{% endschema %}

<style>
.trusted-partner-sec {
    display: flex;
    justify-content: space-between;
    width: 100%;
        align-items: center;
}
.trusted-partner-sec .partner-left-text h2 {
    text-align: left;
    font-size: 36px;
    font-weight: 600;
}
.partner-left-text p {
	margin: 15px 0;
	font-size: 16px;
	line-height: 25px;
	margin-bottom: 25px;
}
.partner-left-text ul {
    padding: 0;
    list-style: none;
    margin: 0;
}
.partner-left-text ul li {
    display: flex;
    width: 100%;
    margin-bottom:20px;
}
.partner-left-text ul li:last-child {
    margin-bottom:0;
}
.partner-left-text ul li .left-icn {
    width: 50px;
}
.partner-left-text ul li .right_text {
    width: 90%;
}
.partner-left-text ul li .right_text h3 {
    font-size: 18px;
    margin: 0;
}
.partner-left-text ul li .right_text p {
    font-size: 14px;
    line-height: 22px;
    margin-top: 5px;
    color:#666666;
    margin-bottom:0;
}
.trusted-partner-sec .partner-left-text, 
.trusted-partner-sec .partner-right-img {
    width: 48%;
}
.brick__section__wrapper {
	min-height: unset;
}
@media only screen and (max-width: 1024px){
.trusted-partner-sec {
	padding: 60px 20px;
}
}
@media only screen and (max-width: 767px){
.trusted-partner-sec {
    flex-wrap: wrap;
}
.trusted-partner-sec .partner-left-text, 
.trusted-partner-sec .partner-right-img {
    width: 100%;
}
.trusted-partner-sec .partner-left-text h2 {
    font-size: 32px;
}
.trusted-partner-sec {
	padding: 50px 0;
}
}
</style>
<div class="brick__section__wrapper wrapper--full-padded six-fifty-height">
<div class="trusted-partner-sec">
  <div class="partner-left-text">
    {% if section.settings.heading != blank %}
      <h2>{{ section.settings.heading }}</h2>
    {% endif %}

    {% if section.settings.description != blank %}
      <p>{{ section.settings.description }}</p>
    {% endif %}

    <ul>
      {% for block in section.blocks %}
        <li {{ block.shopify_attributes }}>
          <div class="left-icn">
            {% if block.settings.icon != blank %}
              <img src="{{ block.settings.icon | image_url: width: 80 }}" alt="{{ block.settings.title }}">
            {% endif %}
          </div>
          <div class="right_text">
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        </li>
      {% endfor %}
    </ul>
  </div>

  <div class="partner-right-img">
  {% if section.settings.right_image != blank %}
    
    <picture>
      {% if section.settings.mobile_image != blank %}
        <source 
          media="(max-width: 767px)" 
          srcset="{{ section.settings.mobile_image | image_url: width: 600 }}">
      {% endif %}
      
      <img 
        src="{{ section.settings.right_image | image_url: width: 800 }}" 
        alt="Trusted Partner">
    </picture>

  {% endif %}
</div>
</div>
</div>