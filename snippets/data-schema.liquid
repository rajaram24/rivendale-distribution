        "merchantReturnDays": 10,
        "returnMethod": "https://schema.org/ReturnByMail",
        "returnFees": "https://schema.org/FreeReturn"
      }
    },
    {
      "@type": "LocalBusiness",
      "@id": "{{shop.url}}/#localbusiness",
      "name": "Rivendell Distribution",
      "url": "{{shop.url}}/",
      "image": "{{shop.url}}/cdn/shop/collections/IMG_0221.jpg",
      "telephone": "+1-970-945-2568",
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "3961 County Road 114",
        "addressLocality": "Glenwood Springs",
        "addressRegion": "CO",
        "postalCode": "81601",
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 39.4862,
        "longitude": -107.2884
      },
      "parentOrganization": {
        "@id": "{{shop.url}}/#organization"
      }
    },
    {
      "@type": "WebSite",
      "@id": "{{shop.url}}/#website",
      "url": "{{shop.url}}/",
      "name": "Rivendell Distribution",
      "publisher": {
        "@id": "{{shop.url}}/#organization"
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": "{{ shop.url }}{{ collection.url }}#breadcrumb",
      "itemListElement": [
        {
		  "@type": "ListItem",
		  "position": 1,
		  "item": {
			"@id": "{{ shop.url }}",
			"name": "Home"
		  }
		},
		{
		  "@type": "ListItem",
		  "position": 2,
		  "item": {
			"@id": "{{ shop.url }}/collections",
			"name": "Collections"
		  }
		},
		{
		  "@type": "ListItem",
		  "position": 3,
		  "item": {
			"@id": "{{ shop.url }}{{ collection.url }}",
			"name": "{{ collection.title }}"
		  }
		}
      ]
    },
    {
      "@type": "CollectionPage",
      "@id": "{{ shop.url }}{{ collection.url }}#webpage",
      "url": "{{ shop.url }}{{ collection.url }}",
      "name": "{{ collection.title | escape }}",
      "headline": "{{ collection.title | escape }}",
      "description": "{{ collection.description | strip_html | escape }}",
      "isPartOf": {
        "@id": "{{shop.url}}/#website"
      },
      "about": {
        "@id": "{{shop.url}}/#organization"
      },
      "breadcrumb": {
        "@id": "{{ shop.url }}{{ collection.url }}#breadcrumb"
      },
      "mainEntity": {
        "@type": "ItemList",
        "@id": "{{ shop.url }}{{ collection.url }}#itemlist",
		"name": "{{ collection.title | escape }} Products",
        "numberOfItems": {{ collection.products_count }},
        "itemListElement": [
          
          {% for product in collection.products %}
          {
            "@type": "ListItem",
            "position": {{ forloop.index }},
            "url": "{{ shop.url }}{{ product.url }}",
            "item": {
              "@type": "Product",
              "@id": "{{ shop.url }}{{ product.url }}#product",
              "name": "{{ product.title | escape }}",
              "url": "{{ shop.url }}{{ product.url }}",
              "image": "{{ product.featured_image | image_url }}",
              "brand": {
                "@type": "Brand",
                "name": "{{ product.vendor | escape }}"
              },
              "offers": {
                "@type": "Offer",
                "url": "{{ shop.url }}{{ product.url }}",
                "price": {{ product.price  | divided_by: 100.00 | json }},
                "priceCurrency": "{{ shop.currency }}",
                "availability": "https://schema.org/{% if product.available %}InStock{% else %}OutOfStock{% endif %}",
                "itemCondition": "https://schema.org/NewCondition"
              }
            }
          }{% unless forloop.last %},{% endunless %}
          {% endfor %}

        ]
      }
    }
  ]
}
</script>
